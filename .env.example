# -----------------------------------------------------------------------------
# Timekeeper — environment template
# Copy to .env at the repository root (and/or apps/api/.env) before running.
# Never commit real secrets.
# -----------------------------------------------------------------------------

NODE_ENV=development

# SQLite local: usado pelo Prisma Migrate para gerar o SQL.
# A API usa o Turso quando TURSO_DATABASE_URL e TURSO_AUTH_TOKEN estão preenchidos.
DATABASE_URL=file:./dev.db
TURSO_DATABASE_URL=libsql://seu-banco-sua-org.turso.io
TURSO_AUTH_TOKEN=

# JWT
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=3000

# Timezone (IANA). All timestamps are stored in UTC and converted for display.
DEFAULT_TIMEZONE=America/Sao_Paulo

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Password reset token TTL
PASSWORD_RESET_EXPIRES_IN=1h

# SMTP (optional in development — password reset is logged when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Timekeeper <noreply@localhost>

# Seed (development only)
SEED_PASSWORD=Timekeeper@123
